# ==============================================================================
# HabitForge — Environment Configuration Template
# ==============================================================================
# NOTE: HabitForge is designed as an offline-first client-side web application
# that operates 100% locally using IndexedDB (Dexie.js). No external backend
# or API keys are required for core operations.
#
# If deploying behind a custom proxy server or sync endpoint, configure below:
# ==============================================================================

PORT=3000
NODE_ENV=production

# Optional Remote Sync Endpoint (Leave commented if using local-only mode)
# SYNC_API_URL=https://api.yourdomain.com/v1
# SYNC_API_KEY=your_api_key_placeholder
